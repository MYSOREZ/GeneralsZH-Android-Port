-				m_vecSTUNServers.push_back( adr );
+				// GeneralsX @bugfix Android port 13/09/2026 Skip duplicates.
+				// ResolveHostname() asks getaddrinfo() with ai_socktype 0, so every
+				// address comes back once per socket type, and distinct hostnames
+				// often share one IP. Duplicates are fatal here:
+				// STUNRequestCallback_ServerReflexiveCandidate moves on with
+				// index_of(addr)+1, and index_of returns the FIRST match -- so inside
+				// a run of equal addresses "the next server" is the same server, and
+				// the walk that was meant to end by falling off the list never does.
+				if ( has_element( m_vecSTUNServers, adr ) )
+					continue;
+				m_vecSTUNServers.push_back( adr );
 			}
