diff --git a/src/dxvk/dxvk_swapchain_blitter.cpp b/src/dxvk/dxvk_swapchain_blitter.cpp
index 1bd581d..a1a917f 100644
--- a/src/dxvk/dxvk_swapchain_blitter.cpp
+++ b/src/dxvk/dxvk_swapchain_blitter.cpp
@@ -1022,7 +1022,21 @@ namespace dxvk {
     dynState.dynamicStateCount = dynStates.size();
     dynState.pDynamicStates = dynStates.data();
 
-    VkGraphicsPipelineCreateInfo blitInfo = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, &rtInfo };
+    // GeneralsX @bugfix Android port 30/07/2026 this pipeline is created
+    // independently of DxvkGraphicsPipeline's own legacy-render-pass
+    // handling, so it needs the same fallback: chain a real (compatible)
+    // VkRenderPass instead of VkPipelineRenderingCreateInfo on devices
+    // without VK_KHR_dynamic_rendering. Confirmed via a real tombstone:
+    // SIGSEGV inside the Mali driver's vkCreateGraphicsPipelines, called
+    // from here with renderPass left at VK_NULL_HANDLE (only valid for
+    // dynamic rendering).
+    auto* legacyPool = m_device->legacyRenderPasses();
+    VkRenderPass legacyRenderPass = VK_NULL_HANDLE;
+
+    if (legacyPool)
+      legacyRenderPass = legacyPool->getCompatibleRenderPass(rtInfo, VK_SAMPLE_COUNT_1_BIT);
+
+    VkGraphicsPipelineCreateInfo blitInfo = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, legacyPool ? nullptr : &rtInfo };
     blitInfo.stageCount = blitStages.size();
     blitInfo.pStages = blitStages.data();
     blitInfo.pVertexInputState = &viState;
@@ -1033,6 +1047,7 @@ namespace dxvk {
     blitInfo.pColorBlendState = &cbState;
     blitInfo.pDynamicState = &dynState;
     blitInfo.layout = m_pipelineLayout;
+    blitInfo.renderPass = legacyRenderPass;
     blitInfo.basePipelineIndex = -1;
 
     VkPipeline pipeline = VK_NULL_HANDLE;
@@ -1131,7 +1146,14 @@ namespace dxvk {
     dynState.dynamicStateCount = dynStates.size();
     dynState.pDynamicStates = dynStates.data();
 
-    VkGraphicsPipelineCreateInfo blitInfo = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, &rtInfo };
+    // GeneralsX @bugfix Android port 30/07/2026 see createPipeline above.
+    auto* legacyPool = m_device->legacyRenderPasses();
+    VkRenderPass legacyRenderPass = VK_NULL_HANDLE;
+
+    if (legacyPool)
+      legacyRenderPass = legacyPool->getCompatibleRenderPass(rtInfo, VK_SAMPLE_COUNT_1_BIT);
+
+    VkGraphicsPipelineCreateInfo blitInfo = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, legacyPool ? nullptr : &rtInfo };
     blitInfo.stageCount = stages.size();
     blitInfo.pStages = stages.data();
     blitInfo.pVertexInputState = &viState;
@@ -1142,6 +1164,7 @@ namespace dxvk {
     blitInfo.pColorBlendState = &cbState;
     blitInfo.pDynamicState = &dynState;
     blitInfo.layout = m_cursorPipelineLayout;
+    blitInfo.renderPass = legacyRenderPass;
     blitInfo.basePipelineIndex = -1;
 
     VkPipeline pipeline = VK_NULL_HANDLE;
