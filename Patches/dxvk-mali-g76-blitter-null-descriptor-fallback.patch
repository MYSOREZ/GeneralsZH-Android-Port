+    // GeneralsX @bugfix Android port 30/07/2026 gamma/hud/cursor
+    // descriptors below are always written into the descriptor set
+    // (all 4 bindings are statically referenced by the shader via spec
+    // constants), even when the corresponding view doesn't exist this
+    // frame -- which left imageView at VK_NULL_HANDLE, only valid when
+    // VK_EXT_robustness2's nullDescriptor is supported. Genuinely absent
+    // on Mali-G76, same as dxvk_context.cpp's descriptor update loop
+    // (dxvk-mali-g76-null-descriptor-fallback.patch); confirmed via a
+    // real tombstone at the same driver call site as that earlier fix.
+    bool hasNullDescriptor = m_device->features().extRobustness2.nullDescriptor;
+
     VkDescriptorImageInfo gammaDescriptor = { };
     gammaDescriptor.sampler = m_samplerGamma->handle();
 
     if (m_gammaView) {
       gammaDescriptor.imageView = m_gammaView->handle();
       gammaDescriptor.imageLayout = m_gammaView->image()->info().layout;
+    } else if (!hasNullDescriptor) {
+      gammaDescriptor.imageView = m_device->dummyResources().imageViewHandle(VK_IMAGE_VIEW_TYPE_2D);
+      gammaDescriptor.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
     }
 
     VkDescriptorImageInfo hudDescriptor = { };
