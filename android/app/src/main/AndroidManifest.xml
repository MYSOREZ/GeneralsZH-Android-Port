<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Vulkan is the entire render path (D3D8 -> DXVK -> Vulkan); refuse to
         install on devices without a Vulkan 1.1 driver. DXVK 2.6 itself needs
         Vulkan 1.3 at runtime — checked with a readable error at startup
         rather than a market filter, so Mali-1.1 devices can still run a
         future fallback renderer build. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- GeneralsX @build Android port 07/07/2026 "All files access": lets the
         in-app folder browser (FolderPickerActivity) resolve to a real
         filesystem path anywhere in shared storage (Downloads, an SD card,
         wherever the user already has the game files) — no adb push, no
         restrictive per-folder scoped-storage grants. tools:ignore silences
         the Play-policy lint warning; this APK is sideloaded, not
         Play-distributed, so that policy does not apply. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- GeneralsX @feature Android port 10/07/2026 GeneralsOnline account
         login (GeneralsOnlineActivity) and, eventually, the native
         multiplayer client both need plain outbound HTTPS/WebSocket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GeneralsX @bugfix Android port 10/07/2026 the sign-in flow backgrounds
         this app for the whole browser round-trip (open playgenerals.online,
         pick Steam/Discord/GameReplays, come back) — on some OEM battery
         managers the poll timer got throttled hard enough that CheckLogin
         never got a chance to run, so a login that visibly succeeded on the
         website never actually completed in the app. Requesting exemption
         from battery optimization (GeneralsOnlineActivity.onSignIn) fixes
         that; this is the normal (non-dangerous) permission needed to even
         show that system prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="false">

        <activity
            android:name=".GeneralsZHActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- GeneralsX @build Android port 07/07/2026 A second, always-present
             launcher icon: configuring the game folder or reading a crash log
             must never depend on the game itself having launched successfully.

             GeneralsX @bugfix Android port 31/07/2026 Was locked to
             "landscape" (same as GeneralsZHActivity) to sidestep a real
             device bug: a portrait->landscape rotation triggered by
             Setup -> Launch Game could still be settling when the game's
             native window-size probe (WW3D::Init()) ran, and it read a
             swapped/portrait window size. Reverted to unspecified
             (portrait-first, matching FolderPickerActivity/
             LogViewerActivity/every other non-game screen) since a locked
             landscape settings menu looked wrong next to those. The race
             this used to sidestep is now handled explicitly instead:
             SetupActivity.onLaunchGame() forces landscape and waits for
             onConfigurationChanged() to actually confirm the rotation
             completed before starting GeneralsZHActivity, rather than
             never rotating in the first place. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/setup_window_title"
            android:icon="@mipmap/ic_launcher_setup"
            android:theme="@style/Theme.GeneralsZHSettings"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FolderPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.GeneralsZHSettings"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.GeneralsZHSettings"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".GeneralsOnlineActivity"
            android:exported="false"
            android:theme="@style/Theme.GeneralsZHSettings"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- GeneralsX @bugfix Android port 11/07/2026 LogViewerActivity's
             Share button used to hand the log over as raw Intent.EXTRA_TEXT,
             which (a) only works with the handful of apps that accept plain
             text (no "Save to Files/Downloads/Drive" target ever showed up),
             and (b) risks TransactionTooLargeException for a big log,
             silently failing to launch anything. Sharing an actual file via
             FileProvider fixes both: any app that handles files (including
             "Save to...") becomes a valid target, and only a small content://
             Uri crosses the Binder, not the log text itself. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
